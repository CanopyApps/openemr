<!-- Document Item Template (for search results) -->
<template id="document-item-template">
    <div class="document-item border rounded p-2 mb-2" style="cursor: pointer;">
        <div class="document-name font-weight-bold"></div>
        <div class="document-meta small text-muted">
            <span class="badge badge-secondary mr-1 document-type-badge"></span>
            <span class="document-size mr-2"></span>
            <span class="document-date"></span>
        </div>
    </div>
</template>

<!-- Result Item Template (for search results) -->
<template id="result-item-template">
    <div class="result-item border rounded p-2 mb-2" style="cursor: pointer;">
        <div class="d-flex justify-content-between">
            <div class="procedure-name font-weight-bold"></div>
            <div class="result-status badge"></div>
        </div>
        <div class="result-value text-primary"></div>
        <div class="result-meta small text-muted">
            <span class="result-date"></span>
        </div>
    </div>
</template>

<!-- Document Badge Template (for linked documents) -->
<template id="document-badge-template">
    <div class="document-item badge badge-secondary mr-1 mb-1">
        <span class="document-badge-text"></span>
        <button type="button" class="btn-close-document ml-1" title="{{ 'Remove document'|xla }}">&times;</button>
    </div>
</template>

<!-- Result Badge Template (for linked results) -->
<template id="result-badge-template">
    <div class="result-item badge badge-info mr-1 mb-1">
        <span class="result-badge-text"></span>
        <button type="button" class="btn-close-result ml-1" title="{{ 'Remove result'|xla }}">&times;</button>
    </div>
</template>

<!-- Empty State Template -->
<template id="empty-state-template">
    <span class="text-muted empty-state-text"></span>
</template>

<!-- Teachback Dialog Template -->
<template id="teachback-dialog-template">
    <div class="teachback-dialog p-3">
        <label class="font-weight-bold mb-2">{{ 'Select Teachback Mode'|xlt }}:</label>
        <div class="row teachback-mode-grid">
            <div class="col-6 mb-2">
                <div class="teachback-mode-card selected" data-mode="all">
                    <input type="radio" name="teachback_mode" value="all" checked class="d-none">
                    <div class="text-center">
                        <i class="fas fa-layer-group fa-2x mb-2 text-success"></i>
                        <div class="font-weight-bold">{{ 'All Modes'|xlt }}</div>
                        <small class="text-muted">{{ 'Codes + AI + Manual'|xlt }}</small>
                    </div>
                </div>
            </div>
            <div class="col-6 mb-2">
                <div class="teachback-mode-card" data-mode="diagnosis_codes">
                    <input type="radio" name="teachback_mode" value="diagnosis_codes" class="d-none">
                    <div class="text-center">
                        <i class="fas fa-diagnoses fa-2x mb-2 text-primary"></i>
                        <div class="font-weight-bold">{{ 'Diagnosis Codes'|xlt }}</div>
                        <small class="text-muted">{{ 'ICD-10 from encounter'|xlt }}</small>
                    </div>
                </div>
            </div>
            <div class="col-6 mb-2">
                <div class="teachback-mode-card" data-mode="ai_analysis">
                    <input type="radio" name="teachback_mode" value="ai_analysis" class="d-none">
                    <div class="text-center">
                        <i class="fas fa-robot fa-2x mb-2 text-info"></i>
                        <div class="font-weight-bold">{{ 'AI Analysis'|xlt }}</div>
                        <small class="text-muted">{{ 'AI reads clinical note'|xlt }}</small>
                    </div>
                </div>
            </div>
            <div class="col-6 mb-2">
                <div class="teachback-mode-card" data-mode="manual">
                    <input type="radio" name="teachback_mode" value="manual" class="d-none">
                    <div class="text-center">
                        <i class="fas fa-edit fa-2x mb-2 text-warning"></i>
                        <div class="font-weight-bold">{{ 'Manual Topic'|xlt }}</div>
                        <small class="text-muted">{{ 'Choose your own topic'|xlt }}</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group mt-2" id="teachback-topic-group" style="display: none;">
            <label for="teachback-topic">{{ 'Topic'|xlt }}:</label>
            <input type="text" class="form-control" id="teachback-topic" placeholder="{{ 'Enter teachback topic...'|xla }}">
        </div>
        <div class="teachback-summary mt-3 p-2 bg-light rounded">
            <div class="d-flex align-items-center">
                <i class="fas fa-globe-americas text-muted mr-2"></i>
                <span class="text-muted mr-1">{{ 'Language'|xlt }}:</span>
                <span id="teachback-patient-language" class="font-weight-bold"></span>
            </div>
        </div>
        <div id="teachback-sending" class="text-center p-3 d-none">
            <div class="spinner-border text-success spinner-border-sm mr-2" role="status"></div>
            {{ 'Sending teachback request...'|xlt }}
        </div>
        <div id="teachback-error" class="alert alert-danger mt-2 d-none"></div>
    </div>
</template>

<style>
  /* Document and result item selection */
  .document-item, .result-item {
    transition: background-color 0.2s;
  }

  .document-item:hover, .result-item:hover {
    background-color: #f8f9fa !important;
  }

  .document-item.selected {
    background-color: #007bff !important;
    color: white !important;
    border-color: #0056b3 !important;
  }

  .result-item.selected {
    background-color: #17a2b8 !important;
    color: white !important;
    border-color: #138496 !important;
  }

  .document-item.selected .badge,
  .result-item.selected .badge {
    background-color: rgba(255, 255, 255, 0.2) !important;
    color: white !important;
  }

  /* Teachback panel */
  .teachback-panel {
    border-left: 4px solid #20c997;
    border-radius: 0.375rem;
    background-color: #f8fdfb;
    padding: 1rem 1.25rem;
  }

  /* Teachback status container */
  .teachback-status-container {
    border-left: 3px solid #6c757d;
    padding: 0.5rem 0.75rem;
    border-radius: 0 0.25rem 0.25rem 0;
    background-color: #fff;
    margin-bottom: 0.5rem;
  }

  .teachback-status-container[data-status="pending"],
  .teachback-status-container[data-status="sent"] {
    border-left-color: #20c997;
    background-color: #f0fdf8;
  }

  .teachback-status-container[data-status="in_progress"] {
    border-left-color: #17a2b8;
    background-color: #f0f9fc;
    animation: teachbackPulse 2s ease-in-out infinite;
  }

  .teachback-status-container[data-status="completed"] {
    border-left-color: #28a745;
    background-color: #f0fdf4;
    animation: teachbackFadeIn 0.5s ease-out;
  }

  .teachback-status-container[data-status="failed"] {
    border-left-color: #dc3545;
    background-color: #fef2f2;
  }

  /* Teachback status badge container */
  .teachback-status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  /* Individual teachback badge */
  .teachback-status-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.6rem;
    border-radius: 50rem;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .teachback-status-badge.status-sent,
  .teachback-status-badge.status-pending {
    background-color: #d1f5ea;
    color: #0d6e4e;
  }

  .teachback-status-badge.status-in-progress {
    background-color: #d1ecf5;
    color: #0c5460;
  }

  .teachback-status-badge.status-completed {
    background-color: #d4edda;
    color: #155724;
  }

  .teachback-status-badge.status-failed {
    background-color: #f8d7da;
    color: #721c24;
  }

  /* Teachback mode cards (dialog) */
  .teachback-mode-card {
    border: 2px solid #dee2e6;
    border-radius: 0.5rem;
    padding: 1rem 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
    background-color: #fff;
  }

  .teachback-mode-card:hover {
    border-color: #20c997;
    background-color: #f8fdfb;
  }

  .teachback-mode-card.selected {
    border-color: #20c997;
    background-color: #e6fcf5;
    box-shadow: 0 0 0 1px #20c997;
  }

  /* Animations */
  @keyframes teachbackPulse {
    0%, 100% { border-left-color: #17a2b8; }
    50% { border-left-color: #8dd8e8; }
  }

  @keyframes teachbackFadeIn {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
